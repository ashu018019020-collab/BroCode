// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String        @id @db.Uuid
  displayName String        @default("") @map("display_name")
  /// Mirror of the Supabase Auth address, for admin display and support.
  /// NOT an identity: `id` is the only key relationships use, because an email can be changed or
  /// re-verified in Auth and a schema keyed on it would silently detach a learner's history.
  email       String?       @db.Text
  /// A URL or a small data URL. Validated on read (`core/platform/avatar.ts`); never a secret.
  avatarUrl   String?       @map("avatar_url") @db.Text
  role        String        @default("user") @db.VarChar(16)
  status      String        @default("active") @db.VarChar(16)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenAt  DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  progress    ProgressSnapshot?
  /// The NumPy course's own records (`nmod:` / `nans:` / `ntick:` / `ncap` / `nlast` / `nlevel`),
  /// stored as validated JSON text so per-section progress follows the account across devices.
  numpyProgress NumpyProgress?
  signInEvents SignInEvent[]

  @@index([lastSeenAt])
  @@map("profiles")
}

model ProgressSnapshot {
  userId           String   @id @map("user_id") @db.Uuid
  xp               Int      @default(0)
  streakCurrent    Int      @default(0) @map("streak_current")
  practicedCount   Int      @default(0) @map("practiced_count")
  doneRecords      Int      @default(0) @map("done_records")
  studyMinutes     Int      @default(0) @map("study_minutes")
  studyDays        Int      @default(0) @map("study_days")
  openMistakes     Int      @default(0) @map("open_mistakes")
  /// The last lesson this account opened, so "Continue Learning" resumes it on any device.
  /// Optional and additive: existing rows simply have NULL and the app falls back to history.
  lastSectionId    String?  @map("last_section_id") @db.VarChar(32)
  lastStage        String?  @map("last_stage") @db.VarChar(16)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user             Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_snapshots")
}

/// Owner-created course cards: a name, a mark, a level and an internal link.
/// They own no generated content, which is why a dashboard may DELETE one; catalog courses are
/// only ever hidden (`course_placement.hidden`) because their slugs key pages and progress.
/// NumPy Mastery's per-course records, one row per account.
/// `payload` is JSON text validated by `server/app.mjs` before it is written: an allowlisted key set,
/// 20 KB per draft, 64 KB total. The aggregate counters stay in `ProgressSnapshot`; this table never
/// carries them, so the two write paths cannot overwrite each other.
model NumpyProgress {
  userId    String   @id @map("user_id") @db.Uuid
  payload   String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("numpy_progress")
}

model OwnerCourse {
  slug      String    @id @db.VarChar(48)
  name      String    @db.VarChar(80)
  summary   String    @default("") @db.VarChar(240)
  href      String    @default("/courses") @db.VarChar(200)
  logo      String    @default("brain") @db.VarChar(24)
  tone      String    @default("cyan") @db.VarChar(16)
  level     String    @db.VarChar(24)
  sortOrder Int       @default(1) @map("sort_order")
  optional  Boolean   @default(false)
  hidden    Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("owner_course")
}

model SignInEvent {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(16)
  signedInAt DateTime @default(now()) @map("signed_in_at") @db.Timestamptz(6)
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, signedInAt(sort: Desc)])
  @@index([signedInAt(sort: Desc)])
  @@map("sign_in_events")
}

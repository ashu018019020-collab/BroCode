# BroCode environment template. Copy to `.env` and fill it in: `cp .env.example .env`.
#
# Two halves, and the split is a SECURITY boundary, not a style choice:
#
#   VITE_*  → inlined into the JavaScript the browser downloads. Anyone can read it. Only the
#             publishable ("anon") key belongs here.
#   the rest → server only (`npm run dev:api`). These must NEVER carry a VITE_ prefix — that
#             prefix is the whole difference between a secret and a published string.
#
# `.env` is gitignored; keep it that way, and never paste a secret into an issue, a screenshot or
# a chat. Rotate in the Supabase dashboard if one is ever exposed.
#
# AN ACCOUNT IS REQUIRED to open courses, lessons, practice, labs and progress. A build without the
# VITE_ pair below is treated as UNCONFIGURED rather than broken: sign-in is impossible and the app
# says so. There is deliberately NO fallback that grants access without a session.
#
# After filling this in, complete the dashboard side too — URL Configuration (Site URL + Redirect
# URLs), the Email provider's "Confirm email" setting, and the password minimum. See
# docs/AUTHENTICATION.md for the exact list; a redirect target that is missing there is silently
# rewritten to the Site URL, which is the usual cause of a confirmation or recovery link going to the
# wrong place.

# ---- Browser (safe to publish) ------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ---- Server only (never VITE_-prefixed) ---------------------------------------
# SUPABASE_PUBLISHABLE_KEY is the same anon key as above; the API uses it to verify the bearer token.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# The secret (service-role) key: full read/write access to the project. Server only.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Postgres is OPTIONAL. Without a real DATABASE_URL the account API runs on Supabase Auth alone
# (see server/auth-store.mjs); account features keep working, without the progress history.
#
# With it, run `npm run db:deploy` (prisma migrate deploy) to create profiles / progress_snapshots /
# sign_in_events and their RLS. The migrations are additive and never drop learner data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# The exact origin the web app is served from. In production this must be HTTPS, and requests from
# any other origin are refused by the API.
WEB_ORIGIN=http://localhost:5173
# Must match the `/api` proxy target in vite.config.ts, or the browser's calls go nowhere.
API_PORT=8787
# Production requires TLS and sends HSTS. Set to `off` only when a trusted proxy terminates TLS
# without forwarding X-Forwarded-Proto.
# ENFORCE_HTTPS=off

# The one account `npm run bootstrap:admin` may promote. It must already exist and be confirmed.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ---- AI voice (server-side speech out) -------------------------------------------
# The tutor speaks through this server, not through a model the visitor downloads. Azure AI Speech
# is used for one reason: it ships a MATCHED PAIR of natural Indian female voices —
#   hi-IN-SwaraNeural (Hindi) and en-IN-NeerjaNeural (English, India).
# so switching language changes the language, not the person. Nothing is downloaded by the browser,
# no GPU is involved and the key never leaves the API process.
#
# Create a Speech resource in the Azure portal (free tier: 500K characters/month, then ~$15/1M),
# then copy its key and region here. These are SERVER-ONLY: never VITE_-prefix them.
# Without them POST /api/voice/tts answers 503 with a message the UI shows — no fake audio, and no
# silent switch to a robotic browser voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Optional: pin other female voices without touching code. The language must match the voice.
# AZURE_SPEECH_VOICE_HI=hi-IN-SwaraNeural
# AZURE_SPEECH_VOICE_EN=en-IN-NeerjaNeural
# Optional: per-request timeout for the provider call, in milliseconds (default 20000).
# AZURE_SPEECH_TIMEOUT_MS=20000

# OPTIONAL — natural realtime voice (OpenAI Realtime over WebRTC). The permanent key is SERVER-ONLY
# and must never carry a VITE_ prefix or reach the browser bundle. Without it, the AI Mentor keeps
# using the browser speech loop and the UI says so. Minting a session requires a signed-in account
# and is rate-limited per account + address.
OPENAI_API_KEY=
# Optional overrides. Default model gpt-realtime; default voice coral (female-sounding).
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=

# OPTIONAL — the TEXT AI interviewer that marks interview answers (server only, same key as above).
# Without a key the Interview Room still works: it falls back to the deterministic keyword rubric and
# labels the result "Built-in rubric", never "AI". Server-only; never VITE_-prefix this.
INTERVIEW_MODEL=
# Optional budget knobs for the evaluator (defaults: 20 requests per 10 minutes per account+address).
INTERVIEW_REQUESTS_PER_WINDOW=
INTERVIEW_WINDOW_MINUTES=

# OPTIONAL — PostHog AI Observability (server only, never VITE_-prefixed). When this key is set, each
# server-side LLM call (the AI interviewer's evaluator) is sent to PostHog as an `$ai_generation`
# event with its model, latency, token usage and cost, grouped into a trace per learner. Empty means
# nothing is sent and the server behaves exactly as before. The provider call itself never changes.
POSTHOG_API_KEY=
# Defaults to https://us.i.posthog.com; set the EU host for an EU project.
POSTHOG_HOST=
# Prompt and completion text is REDACTED by default, so a learner's answer is never shipped to a
# third party (see docs/SECURITY.md). Set to 1 only if you have decided to capture that text too.
POSTHOG_AI_CAPTURE_CONTENT=


# ---- C compiler (server only) --------------------------------------------------
# Judge0 is the only thing that executes learner C. Without JUDGE0_URL the notebook and every
# lab say "compiler not connected" (503) — no output is ever invented locally.
# Self-host: https://github.com/judge0/judge0 (docker compose up), then point this at it.
JUDGE0_URL=http://localhost:2358
# Optional. Only for a hosted Judge0 (RapidAPI): the key and host are sent as headers, never to the browser.
JUDGE0_KEY=
JUDGE0_HOST=
# C (GCC 14) is 103 on the stock Judge0 CE image; override if your image numbers languages differently.
JUDGE0_LANGUAGE_ID=103
C_EXEC_TIMEOUT_MS=12000
C_MAX_SOURCE_BYTES=12000

# BroCode environment template. Copy to `.env` and fill it in: `cp .env.example .env`.
#
# Two halves, and the split is a SECURITY boundary, not a style choice:
#
#   VITE_*  → inlined into the JavaScript the browser downloads. Anyone can read it. Only the
#             publishable ("anon") key belongs here.
#   the rest → server only (`npm run dev:api`). These must NEVER carry a VITE_ prefix — that
#             prefix is the whole difference between a secret and a published string.
#
# `.env` is gitignored; keep it that way, and never paste a secret into an issue, a screenshot or
# a chat. Rotate in the Supabase dashboard if one is ever exposed.
#
# AN ACCOUNT IS REQUIRED to open courses, lessons, practice, labs and progress. A build without the
# VITE_ pair below is treated as UNCONFIGURED rather than broken: sign-in is impossible and the app
# says so. There is deliberately NO fallback that grants access without a session.
#
# After filling this in, complete the dashboard side too — URL Configuration (Site URL + Redirect
# URLs), the Email provider's "Confirm email" setting, and the password minimum. See
# docs/AUTHENTICATION.md for the exact list; a redirect target that is missing there is silently
# rewritten to the Site URL, which is the usual cause of a confirmation or recovery link going to the
# wrong place.

# ---- Browser (safe to publish) ------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ---- Server only (never VITE_-prefixed) ---------------------------------------
# SUPABASE_PUBLISHABLE_KEY is the same anon key as above; the API uses it to verify the bearer token.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# The secret (service-role) key: full read/write access to the project. Server only.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Postgres is OPTIONAL. Without a real DATABASE_URL the account API runs on Supabase Auth alone
# (see server/auth-store.mjs); account features keep working, without the progress history.
#
# With it, run `npm run db:deploy` (prisma migrate deploy) to create profiles / progress_snapshots /
# sign_in_events and their RLS. The migrations are additive and never drop learner data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# The exact origin the web app is served from. In production this must be HTTPS, and requests from
# any other origin are refused by the API.
WEB_ORIGIN=http://localhost:5173
# Must match the `/api` proxy target in vite.config.ts, or the browser's calls go nowhere.
API_PORT=8787
# Production requires TLS and sends HSTS. Set to `off` only when a trusted proxy terminates TLS
# without forwarding X-Forwarded-Proto.
# ENFORCE_HTTPS=off

# The one account `npm run bootstrap:admin` may promote. It must already exist and be confirmed.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
